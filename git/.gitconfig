[user]
  name = Francesc Arpi Roca
  email = francesc.arpi@gmail.com

[alias]
  st = status
	wip = "!f() { if [ -z \"$(git status --porcelain)\" ]; then echo \"nothing to wip (clean tree)\"; return 0; fi; git add -A && git commit -m \"wip: WIP $(date +%Y-%m-%d\\ %H:%M:%S)\"; }; f"
	wiplog = log --oneline --grep=\"^wip:\" -20

[push]
  autoSetupRemote = true

[core]
  pager = delta
  excludesfile = ~/.gitcfg/gitignore.global
  hooksPath = ~/.gitcfg/hooks

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true    # use n and N to move between diff sections
  dark = true
  side-by-side = false
  line-numbers = true
  true-color = always
  diff-so-fancy = true

[merge]
  conflictstyle = diff3

[diff]
  colorMoved = default

[include]
  path = ~/.gitcfg/gitconfig.local
